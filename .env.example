# EcoSync — environment variables
# Copy this file to `.env` and fill in real values before deploying.
# The server reads these via process.env — nothing here is bundled into
# frontend JavaScript, so ENERGY_API_KEY never reaches the browser.

# Port the backend listens on. Most hosts (Render, Railway, Fly.io, etc.)
# set this for you automatically — only override locally if 4600 is busy.
PORT=4600

# --- LIVE MODE (optional) ---------------------------------------------------
# Leave both of these blank/unset to run in SIMULATION MODE (default, and
# what a judge will see if no real meter/API is available).
#
# If ENERGY_API_URL is set, EcoSync polls it every ~8 seconds in the
# background and uses its readings instead of the built-in simulator. If the
# request fails, times out, or returns a response missing solarKw/demandKw,
# EcoSync automatically falls back to SIMULATION MODE and reports the error
# via GET /api/health — it never shows fabricated data labelled as "live".
#
# Expected JSON response shape from ENERGY_API_URL (adapt engine/liveProvider.js
# if your real meter/provider returns a different shape):
#   { "solarKw": 3.2, "demandKw": 2.1, "batterySoc": 61 }
ENERGY_API_URL=
ENERGY_API_KEY=

# --- ECOSYNC AI (optional) --------------------------------------------------
# Powers the "Ask EcoSync AI" chat assistant and the AI-generated summaries
# on the Forecast/Smart Loads panels and the dashboard's AI Insight card.
# Leave GROQ_API_KEY blank to run without it. Create a key in the Groq console.
# Never commit a real key, and never put it in a VITE_*/frontend-exposed variable.
GROQ_API_KEY=
# Optional — defaults to GPT-OSS 120B if unset.
GROQ_MODEL=openai/gpt-oss-120b

# --- AI FALLBACK ------------------------------------------------------------
# Optional second provider. If Groq is rate-limited/unavailable, EcoSync
# automatically tries OpenRouter's free-model router. If that also fails,
# the app uses its local data-grounded fallback, so the chatbot does not die.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- EXTRA AI FAILOVER PROVIDERS -------------------------------------------
# Add any/all keys you have. The server tries providers in order and skips
# recently-failed providers for a short cooldown. None of these are guaranteed
# unlimited; the goal is to make one provider's quota failure non-fatal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=gpt-oss-120b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest

# Local Ollama is the true no-API-quota fallback if you run a model locally.
# Set OLLAMA_ENABLED=true after installing Ollama and pulling a model.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=llama3.2:3b

# Failover tuning
AI_PROVIDER_TIMEOUT_MS=12000
AI_PROVIDER_COOLDOWN_MS=30000
AI_RATE_LIMIT=120

# --- AI COPILOT -------------------------------------------------------------
# The Copilot adds NO new required environment variables. Its analytics,
# anomaly detection, what-if simulator, reports, energy score and AI memory are
# all deterministic and run with no key and no internet.
#
# The AI provider keys above only change HOW answers are phrased:
#   * keys present -> a model plans which tools to run and writes the reply
#   * no keys      -> EcoSync plans with its built-in keyword planner and
#                     composes the reply from the same tool output
# Either way the NUMBERS are identical, because they always come from the
# deterministic engines rather than from the model.
#
# Optional: cap how many requests one client can make per minute (shared with
# the chat endpoint). Defaults to 120.
# AI_RATE_LIMIT=120
